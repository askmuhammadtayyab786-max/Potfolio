# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Contact form email (app/api/contact/route.ts) ---
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where inquiries are delivered
CONTACT_TO_EMAIL=
# Optional: time zone for the "Sent" time in inquiry emails (default Asia/Karachi)
# CONTACT_TIMEZONE=Asia/Karachi

# Optional: use any other SMTP provider instead of Gmail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- AI chat assistant (app/api/chat/route.ts) — Claude via OpenRouter ---
# Key from https://openrouter.ai/settings/keys (top up credit at https://openrouter.ai/settings/credits)
OPENROUTER_API_KEY=
# Optional: model to use (default anthropic/claude-opus-5.5)
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Optional: your live site URL, sent to OpenRouter as the request source
# SITE_URL=https://your-domain.com
